{
  "name": "@aien/omega-harness-cli",
  "version": "0.1.0",
  "description": "Omega Harness interactive CLI powered by the Google GenAI SDK",
  "type": "module",
  "bin": {
    "omega": "./dist/index.js",
    "omega-receipt-lint": "./dist/receipt-lint-cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/receipt-lint-cli.js",
    "dev": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "lint:receipts": "node dist/receipt-lint-cli.js",
    "test": "node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
